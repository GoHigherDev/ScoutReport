NEXT_PUBLIC_APP_CHAIN_ID=88882
NEXT_PUBLIC_DATA_CHAIN_ID=88888
# Server-side RPC overrides only; empty values use public endpoints. Never use NEXT_PUBLIC_ for a provider URL containing an API key.
RPC_URL_MAINNET=
RPC_URL_MAINNET_FALLBACK=
RPC_URL_SPICY=
RPC_WS_URL_MAINNET=
RPC_WS_URL_SPICY=
# Actual trusted origin for SIWE domain/URI checks; HTTPS in production.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_REOWN_PROJECT_ID=
DATABASE_URL=
# Local Compose only; default is local-only-dev. Match this in the local DATABASE_URL.
POSTGRES_PASSWORD=
# Server-only, maintainer-generated, at least 32 characters. Never commit a value.
SESSION_SECRET=
ADMIN_ADDRESSES=
# Restricted server-only secret, independently generated, at least 32 characters.
# Store in deployment secret management; restrict access to authorised erasure operators.
# Never expose in client bundles/logs or commit a value.
PREDICT_ERASURE_SECRET=
# Optional PREDICT_BLOCKED_COUNTRIES: comma-separated ISO codes; unset uses the draft
# counsel-review list. Do not set an empty value. Platform country headers must be overwritten.
# Server-only opt-in, default false in every environment. No estimates without approved calibration.
FEATURE_RP_ESTIMATE=false
# Server-only legal opt-in, default false. Production requires both flags to be exactly true.
RP_ESTIMATE_LEGAL_SIGNOFF=false
# Server-only hosted Mainnet indexer query URL. Never expose it in client bundles.
SUBGRAPH_URL_HOLDINGS=
NEXT_PUBLIC_SUBGRAPH_URL_PREDICTIONS=
