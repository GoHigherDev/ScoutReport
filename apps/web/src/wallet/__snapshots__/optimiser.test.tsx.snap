exports[`optimiser RP caveat > keeps the banner on the optimiser page when connected=false 1`] = `
<DocumentFragment>
  <div
    class="mx-auto w-full max-w-7xl px-4 pt-8 sm:px-6"
  >
    <div
      class="rounded-lg border-l-4 p-4 border-sr-warning bg-sr-surface text-sr-warning space-y-2 text-sm"
      role="status"
    >
      <p>
        Staking from an external wallet does not earn Socios Reward Points. We cannot reliably verify whether this address is a Socios Wallet or qualifies for RP.
      </p>
      <p>
        Staking through the Socios.com app (Socios Wallet) is what earns Socios Reward Points.
      </p>
      <ul
        class="space-y-1"
      >
        <li>
          <a
            class="rounded-sm underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-sr-warning"
            href="https://connect.socios.com/interact-with-chiliz-chain/working-with-staking"
            rel="noopener noreferrer"
            target="_blank"
          >
            Socios Connect, Working with Staking
          </a>
        </li>
        <li>
          <a
            class="rounded-sm underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-sr-warning"
            href="https://helpcenter.socios.com/en/articles/472518-how-do-i-earn-reward-points"
            rel="noopener noreferrer"
            target="_blank"
          >
            Socios Help Centre, How do I earn Reward Points?
          </a>
        </li>
        <li>
          <a
            class="rounded-sm underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-sr-warning"
            href="https://helpcenter.socios.com/en/articles/472529-do-i-need-fan-tokens-to-vote"
            rel="noopener noreferrer"
            target="_blank"
          >
            Socios Help Centre, Do I need Fan Tokens to vote?
          </a>
        </li>
      </ul>
    </div>
  </div>
  <main
    class="mx-auto w-full max-w-7xl space-y-6 px-4 py-8 sm:px-6"
  >
    <h1
      class="text-3xl font-bold"
    >
      Rewards Optimizer
    </h1>
    <section
      aria-label="Rewards Optimizer"
      class="space-y-4"
    >
      <span
        class="inline-flex items-center rounded-full px-3 py-1 text-sm font-medium bg-sr-surface text-sr-text"
      >
        Reading Chiliz Mainnet data
      </span>
      <div
        class="rounded-lg border-l-4 p-4 border-sr-warning bg-sr-surface text-sr-warning"
        role="status"
      >
        <ul
          class="space-y-2 text-sm"
        >
          <li>
            ScoutReport is not affiliated with Socios. Rewards Optimizer shows available on-chain data; it cannot verify your Socios Reward Points or forecast RP yields.
          </li>
          <li>
            To vote, you must own and stake at least one Fan Token of that team. Some polls require more or have additional conditions. Check the poll's requirements in Socios; an on-chain balance does not guarantee eligibility.
          </li>
          <li>
            Poll coverage may be incomplete. Times and balances reflect the stated capture block and may change. Pending unstake is not a liquid wallet balance.
          </li>
        </ul>
      </div>
      <p
        role="status"
      >
        Connect your wallet to view your Fan Token checklist.
      </p>
    </section>
  </main>
</DocumentFragment>
`;

