      "checkConstraints": {
        "matches_sport": {
          "name": "matches_sport",
          "value": "\"matches\".\"sport\" IN ('football', 'cs2')"
        },
        "matches_lock_at": {
          "name": "matches_lock_at",
          "value": "\"matches\".\"lock_at_utc\" <= \"matches\".\"kickoff_utc\""
        },
        "matches_points": {
          "name": "matches_points",
          "value": "\"matches\".\"points_for_correct\" BETWEEN 1 AND 100"
        },
        "matches_outcomes": {
          "name": "matches_outcomes",
          "value": "CASE WHEN jsonb_typeof(\"matches\".\"outcomes\") = 'array' THEN (jsonb_array_length(\"matches\".\"outcomes\") BETWEEN 2 AND 3 AND jsonb_typeof(\"matches\".\"outcomes\"->0) = 'string' AND jsonb_typeof(\"matches\".\"outcomes\"->1) = 'string' AND length(trim(\"matches\".\"outcomes\"->>0)) > 0 AND length(trim(\"matches\".\"outcomes\"->>1)) > 0 AND \"matches\".\"outcomes\"->>0 <> \"matches\".\"outcomes\"->>1 AND (jsonb_array_length(\"matches\".\"outcomes\") = 2 OR (jsonb_typeof(\"matches\".\"outcomes\"->2) = 'string' AND length(trim(\"matches\".\"outcomes\"->>2)) > 0 AND \"matches\".\"outcomes\"->>2 <> \"matches\".\"outcomes\"->>0 AND \"matches\".\"outcomes\"->>2 <> \"matches\".\"outcomes\"->>1))) ELSE false END"
        },
        "matches_status": {
          "name": "matches_status",
          "value": "\"matches\".\"status\" IN ('open', 'settled', 'voided')"
        },
        "matches_status_result": {
          "name": "matches_status_result",
          "value": "(\"matches\".\"status\" = 'settled' AND \"matches\".\"result\" IS NOT NULL AND \"matches\".\"outcomes\" ? \"matches\".\"result\" OR \"matches\".\"status\" <> 'settled' AND \"matches\".\"result\" IS NULL)"
        },
        "matches_void_reason": {
          "name": "matches_void_reason",
          "value": "(\"matches\".\"status\" = 'voided' AND \"matches\".\"void_reason\" IS NOT NULL AND length(trim(\"matches\".\"void_reason\")) > 0 OR \"matches\".\"status\" <> 'voided' AND \"matches\".\"void_reason\" IS NULL)"
        },
        "matches_created_by_lowercase": {
          "name": "matches_created_by_lowercase",
          "value": "\"matches\".\"created_by\" ~ '^0x[0-9a-f]{40}$'"
        }
      },
