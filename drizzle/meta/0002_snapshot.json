          "value": "(jsonb_typeof(\"matches\".\"sides\") = 'array' AND jsonb_array_length(\"matches\".\"sides\") = 2 AND jsonb_typeof(\"matches\".\"sides\"->0->'name') = 'string' AND length(trim(\"matches\".\"sides\"->0->>'name')) > 0 AND jsonb_typeof(\"matches\".\"sides\"->1->'name') = 'string' AND length(trim(\"matches\".\"sides\"->1->>'name')) > 0 AND jsonb_typeof(\"matches\".\"sides\"->0->'tokenKey') IN ('string', 'null') AND jsonb_typeof(\"matches\".\"sides\"->1->'tokenKey') IN ('string', 'null')) IS TRUE"
        },
        "matches_outcomes": {
          "name": "matches_outcomes",
          "value": "(jsonb_typeof(\"matches\".\"outcomes\") = 'array' AND jsonb_array_length(\"matches\".\"outcomes\") BETWEEN 2 AND 3 AND jsonb_typeof(\"matches\".\"outcomes\"->0) = 'string' AND jsonb_typeof(\"matches\".\"outcomes\"->1) = 'string' AND length(trim(\"matches\".\"outcomes\"->>0)) > 0 AND length(trim(\"matches\".\"outcomes\"->>1)) > 0 AND \"matches\".\"outcomes\"->>0 <> \"matches\".\"outcomes\"->>1 AND (jsonb_array_length(\"matches\".\"outcomes\") = 2 OR (jsonb_typeof(\"matches\".\"outcomes\"->2) = 'string' AND length(trim(\"matches\".\"outcomes\"->>2)) > 0 AND \"matches\".\"outcomes\"->>2 <> \"matches\".\"outcomes\"->>0 AND \"matches\".\"outcomes\"->>2 <> \"matches\".\"outcomes\"->>1))) IS TRUE"
