{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["packages/contracts/deployments/*.json"],
  "globalEnv": [
    "DATABASE_URL",
    "ADMIN_ADDRESSES",
    "NEXT_PUBLIC_APP_CHAIN_ID",
    "NEXT_PUBLIC_DATA_CHAIN_ID",
    "NEXT_PUBLIC_REOWN_PROJECT_ID",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_SUBGRAPH_URL_PREDICTIONS",
    "SUBGRAPH_URL_HOLDINGS",
    "SESSION_SECRET",
    "FEATURE_RP_ESTIMATE",
    "RPC_URL_MAINNET",
    "RPC_URL_MAINNET_FALLBACK",
    "RPC_URL_SPICY",
    "RPC_WS_URL_MAINNET",
    "RPC_WS_URL_SPICY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        "out/**",
        "artifacts/**",
        "cache/**",
        "generated/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
